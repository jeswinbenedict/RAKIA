# RAKIA environment variables — names and safe defaults only.
# Copy to `.env` (git-ignored) and fill in locally. NEVER commit real values.

# --- Runtime environment: development | staging | production ---
RAKIA_ENV=development

# --- PostgreSQL (API connects as a least-privilege role) ---
RAKIA_DB_HOST=localhost
RAKIA_DB_PORT=5432
RAKIA_DB_NAME=rakia
RAKIA_DB_USER=rakia_api
RAKIA_DB_PASSWORD=
# disable | require | verify-full  (use verify-full outside local development)
RAKIA_DB_SSLMODE=disable
# Separate role used only by the migration runner
RAKIA_DB_MIGRATOR_USER=rakia_migrator
RAKIA_DB_MIGRATOR_PASSWORD=

# --- Firebase Authentication (public project identifiers; used to validate ID tokens) ---
RAKIA_FIREBASE_PROJECT_ID=

# --- Cloudflare Turnstile ---
# Server-side secret: keep private.
RAKIA_TURNSTILE_SECRET_KEY=
# Site key is public and is passed to the app at build time.
RAKIA_TURNSTILE_SITE_KEY=

# --- API server ---
RAKIA_API_HOST=127.0.0.1
RAKIA_API_PORT=8080
# Comma-separated list of allowed web origins (https only outside development)
RAKIA_CORS_ORIGINS=http://localhost:5000
# Requests per minute per client address (per API instance)
RAKIA_API_RATE_LIMIT_PER_MINUTE=120
# Reverse proxies in front of the API that append to X-Forwarded-For (1 on Cloud Run)
RAKIA_TRUSTED_PROXY_HOPS=0
# Database connections per API instance
RAKIA_API_DB_POOL_SIZE=4

# --- Supabase (staging/production only) ---
RAKIA_SUPABASE_URL=
# Never put the service-role key in the app; server-side use only, if at all.
RAKIA_SUPABASE_SERVICE_ROLE_KEY=
