<?xml version="1.0" encoding="utf-8"?>
<!--
  Health data stays on the device: nothing is copied to cloud backups or to a
  new device. The database key lives in the Android Keystore, which is never
  backed up, so a copied database could not be read anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
