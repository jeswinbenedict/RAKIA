          2
        ],
        "name": "measurements_immutable",
        "sql": "CREATE TRIGGER measurements_immutable\nBEFORE UPDATE ON measurements\nBEGIN\n  SELECT RAISE(ABORT, 'rakia: measurements are immutable');\nEND;"
      }
    },
    {
      "id": 5,
      "references": [
        2,
        1
      ],
      "type": "trigger",
      "data": {
        "on": 2,
        "references_in_body": [
          2,
          1
        ],
        "name": "measurements_simulation_firewall",
        "sql": "CREATE TRIGGER measurements_simulation_firewall\nBEFORE INSERT ON measurements\nWHEN (NEW.provenance = 3) <>\n     (SELECT is_simulation = 1 FROM missions WHERE id = NEW.mission_id)\nBEGIN\n  SELECT RAISE(ABORT, 'rakia: simulation firewall');\nEND;"
      }
    },
    {
      "id": 6,
      "references": [
        2,
        1
      ],
      "type": "trigger",
      "data": {
        "on": 2,
        "references_in_body": [
          2,
          1
        ],
        "name": "measurements_subject_matches_mission",
        "sql": "CREATE TRIGGER measurements_subject_matches_mission\nBEFORE INSERT ON measurements\nWHEN NEW.subject_id IS NOT\n     (SELECT subject_id FROM missions WHERE id = NEW.mission_id)\nBEGIN\n  SELECT RAISE(ABORT, 'rakia: subject does not match the mission');\nEND;"
      }
    },
    {
      "id": 7,
      "references": [
        2
      ],
      "type": "trigger",
      "data": {
        "on": 2,
        "references_in_body": [
          2
        ],
        "name": "measurements_chain_continuity",
        "sql": "CREATE TRIGGER measurements_chain_continuity\nBEFORE INSERT ON measurements\nWHEN NEW.client_seq <> COALESCE(\n       (SELECT MAX(client_seq) FROM measurements\n        WHERE mission_id = NEW.mission_id), 0) + 1\n  OR NEW.prev_hash IS NOT COALESCE(\n       (SELECT hash FROM measurements\n        WHERE mission_id = NEW.mission_id\n          AND client_seq = NEW.client_seq - 1),\n       zeroblob(32))\nBEGIN\n  SELECT RAISE(ABORT, 'rakia: ledger chain is not continuous');\nEND;"
      }
    },
    {
      "id": 8,
      "references": [
        2,
        1
      ],
      "type": "trigger",
      "data": {
        "on": 2,
        "references_in_body": [
          2,
          1
        ],
        "name": "measurements_delete_simulation_only",
        "sql": "CREATE TRIGGER measurements_delete_simulation_only\nBEFORE DELETE ON measurements\nWHEN (SELECT is_simulation FROM missions WHERE id = OLD.mission_id) = 0\nBEGIN\n  SELECT RAISE(ABORT, 'rakia: only simulation data can be deleted');\nEND;"
      }
    },
    {
      "id": 9,
