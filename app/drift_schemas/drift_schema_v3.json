        ],
        "name": "missions_identity_immutable",
        "sql": "CREATE TRIGGER missions_identity_immutable\nBEFORE UPDATE OF id, is_simulation, simulation_seed, subject_id, start_at_us\nON missions\nBEGIN\n  SELECT RAISE(ABORT, 'rakia: a mission''s identity cannot change');\nEND;"
      }
    },
